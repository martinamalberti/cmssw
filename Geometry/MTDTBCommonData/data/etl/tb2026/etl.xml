    <Vector name="Offset_Front_Disc_1" type="numeric" nEntries="27">
      4, 4, 0, 0, 0, 0, 0, 0, 2, 6, 12, 12, 14, 16, 14, 12, 10, 4, 0, 0, 0, 0, 0, 0, 0, 4, 0
