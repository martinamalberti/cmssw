     <Vector name="Services_Front_Disc_1" type="numeric" nEntries="71">
      3, 7, 7, 6, 7, 6, 3, 6, 6, 6, 7, 6, 6, 7, 7, 7, 7, 7, 7, 7, 6, 6, 7, 7,
      3, 7, 7, 3, 7, 7, 3, 7, 6, 3, 6, 6, 3, 7, 6, 3, 7, 7, 3, 6, 6, 6, 6, 6, 
      6, 7, 7, 6, 7, 6, 6, 3, 7, 7, 6, 7, 6, 6, 7, 7, 3, 6, 6, 3, 6, 6, 7
    </Vector>

    <Vector name="Services_Back_Disc_1" type="numeric" nEntries="71">
      3, 7, 3, 7, 7, 7, 6, 3, 6, 6, 6, 7, 7, 6, 7, 7, 7, 7, 7, 6, 6, 6, 6, 6,
      6, 6, 6, 6, 6, 7, 7, 3, 6, 6, 3, 6, 6, 3, 7, 7, 3, 7, 7, 3, 7, 7, 6, 6,
      6, 6, 7, 7, 6, 7, 7, 7, 7, 7, 6, 7, 6, 6, 7, 7, 3, 6, 6, 3, 6, 6, 6
    </Vector>

    <Vector name="Services_Front_Disc_2" type="numeric" nEntries="71">
      3, 7, 7, 6, 7, 6, 3, 6, 6, 6, 7, 6, 6, 7, 7, 7, 7, 7, 7, 7, 6, 6, 6, 6,
      6, 7, 6, 6, 7, 7, 3, 7, 6, 3, 6, 6, 3, 7, 6, 3, 7, 7, 3, 7, 6, 6, 6, 6,
      6, 7, 7, 6, 7, 6, 6, 3, 7, 7, 6, 7, 6, 6, 7, 7, 3, 6, 6, 3, 6, 6, 7
    </Vector>

    <Vector name="Services_Back_Disc_2" type="numeric" nEntries="71">
      3, 7, 3, 7, 7, 7, 6, 3, 6, 6, 6, 7, 7, 6, 7, 7, 7, 7, 7, 6, 6, 6, 6, 6,
      6, 6, 6, 6, 6, 7, 7, 3, 6, 6, 3, 6, 6, 3, 7, 7, 3, 7, 7, 3, 7, 7, 6, 6,
      6, 6, 7, 7, 6, 7, 7, 7, 7, 7, 6, 7, 6, 6, 7, 7, 3, 6, 6, 3, 6, 6, 6
