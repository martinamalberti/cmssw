<?xml version="1.0"?>
<DDDefinition>
  <!--
      ETL test beam 2026: three single-module planes along z.

      The module is the ETL v11 one (Geometry/MTDCommonData/data/etl/v11/etl.xml): 2 half modules,
      each with 2 LGAD sensors of 16x16 pixels (1.3 mm pitch).
      All the planes use the "Back" flavour of the v11 module, i.e. the base plate (AlN) and the
      LGAD sensors face -z, so that a beam travelling along +z enters from the sensor side.

      The container volumes keep the names and the hierarchy of the ETL v11 geometry, as required by
      ETLNumberingScheme and by the MTD numbering construction:
        EndcapTimingLayer -> DiscNTiming -> DiscSector_[Front|Back]_N -> module_ServiceHybrid3_Back
        -> Module_Back -> Half_Module_Back -> LGAD -> LGAD_active
      Mapping of the planes:
        plane 1 (z = TBplane1_z) : Disc1Timing / DiscSector_Front_1
        plane 2 (z = TBplane2_z) : Disc1Timing / DiscSector_Back_1
        plane 3 (z = TBplane3_z) : Disc2Timing / DiscSector_Front_2
      The z positions refer to the centre of the module, in the cms:OCMS frame (the envelopes
      defined in Geometry/MTDTBCommonData/data/etl/tb2026/cms.xml are centred in the origin and
      allow |z| up to about 1 m).
      All the containers are boxes filled with air.
  -->

  <RotationSection label="etl.xml">
    <Rotation name="RPCD_plus_90CW" thetaX="90*deg" phiX="-90*deg" thetaY="90*deg" phiY="180*deg" thetaZ="180*deg" phiZ="0*deg"/>
  </RotationSection>

  <ConstantsSection label="etl.xml" eval="true">
    <!-- Test beam layout -->
    <Constant name="TBplane1_z" value="0.*mm"/>
    <Constant name="TBplane2_z" value="200.*mm"/>
    <Constant name="TBplane3_z" value="400.*mm"/>
    <Constant name="TBmargin" value="1.*mm"/> <!-- clearance added at each level of the container hierarchy -->
    <Constant name="ETLcenter_z" value="0.5*([TBplane1_z]+[TBplane3_z])"/>
    <Constant name="Disc1center_z" value="0.5*([TBplane1_z]+[TBplane2_z])"/>
    <Constant name="Disc2center_z" value="[TBplane3_z]"/>

    <!-- Module, from ETL v11 -->
    <Constant name="Module_Y" value="28.75*mm"/>
    <Constant name="Module_X" value="44.1*mm"/>
    <Constant name="Module_Z" value="7.63*mm"/>
    <Constant name="LGADdy" value="21.4*mm"/> <!-- 16 pixels of 1.3 mm -->
    <Constant name="LGADdx" value="21.6*mm"/> <!-- 16 pixels of 1.3 mm -->
    <Constant name="LGAD_active" value="0.05*mm"/>
    <Constant name="LGAD_Substrate" value="0.25*mm"/>
    <Constant name="LGAD_Z" value="0.3*mm"/>
    <Constant name="glueLGAD_Z" value="0.1*mm"/>
    <Constant name="bumpBonds_Z" value="0.1*mm"/>
    <Constant name="ETROCdy" value="23*mm"/>
    <Constant name="ETROCdx" value="21*mm"/>
    <Constant name="ETROC_Z" value="0.25*mm"/>
    <Constant name="glueETROC_Z" value="0.05*mm"/>
    <Constant name="Laird_Y" value="23*mm"/>
    <Constant name="Laird_X" value="43.05*mm"/>
    <Constant name="modulePCB_Z" value="0.45*mm"/>
    <Constant name="connectorsGap_Z" value="0.7*mm"/>
    <Constant name="ReadoutBoard_Z" value="1*mm"/>
    <Constant name="servicesModule_Z" value="2.8*mm"/>
    <Constant name="ThermalPad_Z" value="0.25*mm"/>
    <Constant name="AlN_Base_Z" value="1.5*mm"/>
    <Constant name="LairdFilm_Z" value="0.08*mm"/>
    <Constant name="ETROC_translation_x" value="11.025*mm"/>
    <Constant name="LGAD_translation_x" value="11.025*mm"/>
    <Constant name="ETROC_translation_y" value="2.35*mm"/>
    <Constant name="LGAD_translation_y" value="3*mm"/>
    <Constant name="ThermalPad_translation_z" value="3.69*mm"/>
    <Constant name="AlN_Base_translation_z" value="2.815*mm"/>
    <Constant name="LairdFilm_translation_z" value="2.025*mm"/>
    <Constant name="glueLGAD_translation_z" value="1.935*mm"/>
    <Constant name="LGAD_translation_z" value="1.735*mm"/>
    <Constant name="bumpBonds_translation_z" value="1.535*mm"/>
    <Constant name="ETROC_translation_z" value="1.36*mm"/>
    <Constant name="glueETROC_translation_z" value="1.185*mm"/>
    <Constant name="modulePCB_translation_z" value="0.91*mm"/>
    <Constant name="connectorsGap_translation_z" value="0.335*mm"/>
    <Constant name="readoutBoard_translation_z" value="-0.515*mm"/>
    <Constant name="servicesModule_translation_z" value="-2.415*mm"/>
    <Constant name="LGAD_active_translation_z" value="-0.125*mm"/>
    <Constant name="LGAD_Substrate_translation_z" value="0.025*mm"/>

    <!-- ETL v11 disc layout vectors, copied unchanged: they are required by MTDParametersFromDD and
         used only by MTDTopology (module search on the full discs), not by the test beam geometry -->

