    <Vector name="Offset_Front_Disc_2" type="numeric" nEntries="27">
      4, 4, 0, 0, 0, 0, 0, 0, 2, 4, 8, 12, 14, 16, 14, 12, 8, 4, 0, 0, 0, 0, 0, 0, 0, 4, 0
