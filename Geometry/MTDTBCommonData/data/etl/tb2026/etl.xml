    <Vector name="Offset_Back_Disc_2" type="numeric" nEntries="27">
      4, 0, 0, 0, 0, 0, 0, 0, 4, 6, 10, 12, 16, 16, 12, 12, 6, 4, 0, 0, 0, 0, 0, 0, 0, 4, 0
