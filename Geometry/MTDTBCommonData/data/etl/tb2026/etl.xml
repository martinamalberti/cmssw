  </ConstantsSection>

  <SolidSection label="etl.xml">
    <!-- Test beam containers (half sizes) -->
    <Box name="EndcapTimingLayer" dx="0.5*[Module_X]+4*[TBmargin]" dy="[Module_Y]+4*[TBmargin]"
         dz="0.5*([TBplane3_z]-[TBplane1_z])+0.5*[Module_Z]+4*[TBmargin]"/>
    <Box name="Disc1Timing" dx="0.5*[Module_X]+3*[TBmargin]" dy="[Module_Y]+3*[TBmargin]"
         dz="0.5*([TBplane2_z]-[TBplane1_z])+0.5*[Module_Z]+3*[TBmargin]"/>
    <Box name="Disc2Timing" dx="0.5*[Module_X]+3*[TBmargin]" dy="[Module_Y]+3*[TBmargin]"
         dz="0.5*[Module_Z]+3*[TBmargin]"/>
    <Box name="DiscSector" dx="0.5*[Module_X]+2*[TBmargin]" dy="[Module_Y]+2*[TBmargin]" dz="0.5*[Module_Z]+2*[TBmargin]"/>
    <Box name="module_ServiceHybrid3" dx="0.5*[Module_X]+[TBmargin]" dy="[Module_Y]+[TBmargin]" dz="0.5*[Module_Z]+[TBmargin]"/>

    <!-- Module, from ETL v11 -->
    <Box name="Half_Module" dx="0.5*[Module_X]" dy="0.5*[Module_Y]" dz="0.5*[Module_Z]"/>
    <Box name="Module" dx="0.5*[Module_X]" dy="[Module_Y]" dz="0.5*[Module_Z]"/>
    <Box name="ThermalPad" dx="0.5*[Module_X]" dy="0.5*[Module_Y]" dz="0.5*[ThermalPad_Z]"/>
    <Box name="LairdFilm" dx="0.5*[Laird_X]" dy="0.5*[Laird_Y]" dz="0.5*[LairdFilm_Z]"/>
    <Box name="AlN_Base" dx="0.5*[Module_X]" dy="0.5*[Module_Y]" dz="0.5*[AlN_Base_Z]"/>
    <Box name="glueLGAD" dx="0.5*[LGADdx]" dy="0.5*[LGADdy]" dz="0.5*[glueLGAD_Z]"/>
    <Box name="BumpBonds" dx="0.5*[LGADdx]" dy="0.5*[LGADdy]" dz="0.5*[bumpBonds_Z]"/>
    <Box name="LGAD" dx="0.5*[LGADdx]" dy="0.5*[LGADdy]" dz="0.5*[LGAD_Z]"/>
    <Box name="LGAD_active" dx="0.5*[LGADdx]" dy="0.5*[LGADdy]" dz="0.5*[LGAD_active]"/>
    <Box name="LGAD_Substrate" dx="0.5*[LGADdx]" dy="0.5*[LGADdy]" dz="0.5*[LGAD_Substrate]"/>
    <Box name="ETROC" dx="0.5*[ETROCdx]" dy="0.5*[ETROCdy]" dz="0.5*[ETROC_Z]"/>
    <Box name="glueETROC" dx="0.5*[ETROCdx]" dy="0.5*[ETROCdy]" dz="0.5*[glueETROC_Z]"/>
    <Box name="ModulePCB" dx="0.5*[Module_X]" dy="0.5*[Module_Y]" dz="0.5*[modulePCB_Z]"/>
    <Box name="connectorsGap" dx="0.5*[Module_X]" dy="0.5*[Module_Y]" dz="0.5*[connectorsGap_Z]"/>
    <Box name="ReadoutBoard" dx="0.5*[Module_X]" dy="0.5*[Module_Y]" dz="0.5*[ReadoutBoard_Z]"/>
    <Box name="servicesModule" dx="0.5*[Module_X]" dy="0.5*[Module_Y]" dz="0.5*[servicesModule_Z]"/>
  </SolidSection>

