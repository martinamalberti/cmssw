</SpecPar>

<SpecPar name="mtdNumbering">
  <PartSelector path="//etl:EndcapTimingLayer"/>
  <Parameter name="OnlyForMTDRecNumbering" value="MTD" eval="false"/>
  <Parameter name="TopologyMode" value="MTDTopologyMode::btlv4etlv11" eval="false"/>
</SpecPar>

</SpecParSection>
</DDDefinition>
